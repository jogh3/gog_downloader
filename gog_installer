#!/usr/bin/env bash

# package tests
type curl > /dev/null 2>&1
if [[ $? -eq 1 ]]; then
  echo "curl not installed" >&2
  exit 1
fi
type jq > /dev/null 2>&1
if [[ $? -eq 1 ]]; then
  echo "jq not installed" >&2
  exit 1
fi

type sort > /dev/null 2>&1
if [[ $? -eq 1 ]]; then
  echo "sort not installed" >&2
  exit 1
fi

# a test to see if associative arrays work
if ! declare -A test_arr; then
  echo "unable to declare associative array, check bash version, needs to be 4.0 or above" >&2
  exit 1
fi
unset test_arr
# constants
readonly config_dir="$HOME/.config/gog_downloader"
readonly config_file="$config_dir/config.json"
readonly default_dl_loc="$HOME/Documents/gog_games"
readonly save_cursor_position='\e[s'
readonly reset_menu_area='\e[u\e[J'
dllocfolder=""
mkdir -p "$config_dir"

max_cores=0
user_inp_cores=0

auth_code=""
refresh_token=""

# gets the number of ONLINE cores that the system has available
get_num_cores() {
  read -r online_str < /sys/devices/system/cpu/online
  IFS=',' read -ra elements <<< "$online_str"

  for item in "${elements[@]}"; do
      if [[ "$item" =~ - ]]; then
          IFS='-' read -r start end <<< "$item"
          (( max_cores += end - start + 1 ))
      else
          (( max_cores++ ))
      fi
  done
  (( max_cores-- ))
}

# parses the arguments passed into the script
parse_args(){

  local help_message="
  gog_installer - downloads executables from gog
  
    --set-download-location DIRECTORY_LOCATION sets the location where the mods will download to
    --help -h displays this message
  "

  while [[ "$#" -gt 0 ]]; do
    case $1 in
      -h|--help)
        echo "$help_message"
        exit 0
        ;;
      --set-download-location)
        if [[ -z "$2" ]] || [[ "$2" =~ ^- ]]; then
          echo "no download location specified"
          exit 1
        fi
        
        if [[ "$2" == "~"* ]]; then
          dllocfolder="${2/#\~/$HOME}"
        elif [[ "$2" == "default" ]]; then
          dllocfolder=$default_dl_loc
        else
          dllocfolder=$2
        fi
        dllocfolder=$(realpath -m "$dllocfolder")
        dllocfolder="${dllocfolder%/}"
        shift 2
        ;;
      -s|--set-max-cores)
        if [[ -z "$2" ]] || [[ "$2" =~ ^- ]]; then
          echo "no core amount specified"
          exit 1
        fi
        user_inp_cores=$2
        shift 2
        ;;
      *)
        echo "unknow argument: $1"
        echo "$help_message"
        exit 1
        ;;
    esac
  done
}

# this sets up the first time authentication, shouldn't need to be done more than once
get_authentication(){
  echo "open: https://auth.gog.com/auth?client_id=46899977096215655&redirect_uri=https%3A%2F%2Fembed.gog.com%2Fon_login_success%3Forigin%3Dclient&response_type=code&layout=client2"
  local redirect_url
  read -rp "paste the full redirect url here: " redirect_url
  local login_code=$(echo "$redirect_url" | grep -oP 'code=\K[^&]+')
  local code_response=$(curl -s "https://auth.gog.com/token?client_id=46899977096215655&client_secret=9d85c43b1482497dbbce61f6e4aa173a433796eeae2ca8c5f6129f2dc4de46d9&grant_type=authorization_code&code=$login_code&redirect_uri=https%3A%2F%2Fembed.gog.com%2Fon_login_success%3Forigin%3Dclient")
  refresh_token=$( echo $code_response | jq -r '.refresh_token')
  if [[ "$refresh_token" == "null" ]]; then
    refresh_token=""
  fi
  auth_code=$(echo $code_response | jq -r '.access_token')
  if [[ $auth_code == "null" ]]; then
    auth_code=""
  fi
}

# uses the refresh token you get from the first authentication, then renews it
use_refresh() {
  local saved_refresh_token=$( jq -r '.refresh_token' "$config_file")
  local response=$(curl -s "https://auth.gog.com/token?client_id=46899977096215655&client_secret=9d85c43b1482497dbbce61f6e4aa173a433796eeae2ca8c5f6129f2dc4de46d9&grant_type=refresh_token&refresh_token=$saved_refresh_token")
  local new_refresh_token=$(echo "$response" | jq -r '.refresh_token')
  if [[ "$new_refresh_token" != "null" ]]; then
    jq --arg refresh_token "$new_refresh_token" '.refresh_token = $refresh_token' "$config_file" > /tmp/tmp.json && mv /tmp/tmp.json "$config_file"
  else
    echo "no refresh token returned"
    jq '.refresh_token = ""' "$config_file" > /tmp/tmp.json && mv /tmp/tmp.json "$config_file"
    exit 0
  fi
  auth_code=$(echo "$response" | jq -r '.access_token')
  if [[ "$auth_code" == "null" ]]; then
    echo "no auth_code returned"
    exit 0
  fi
}

# gets the full game list
get_game_list() {
  local game_id_list_url="https://embed.gog.com/user/data/games"
  local game_id_list=$(curl -s -H "Authorization: Bearer $auth_code" $game_id_list_url)
  local game_id_arr=( $( echo $game_id_list | jq '.owned.[]' ) )
  local total_games=${#game_id_arr[@]}
  local full_game_array=()
  local oifs=$IFS
  IFS=","
  # the products api call has a maximum of 50 items, so splits it into 50 item chunks
  for (( i=0;i<total_games;i+=50 )); do
    # sleep to not overwhelm the api and get banned
    if [[ $i -gt 0 ]]; then
      sleep 0.5
    fi
    local chunk=("${game_id_arr[@]:i:50}")
    local game_id_csv="${chunk[*]}"
    local game_info_url="https://api.gog.com/products?ids=$game_id_csv"
    local chunk_data=$(curl -s "$game_info_url")
    # appends the ids to the game array
    readarray -t -O "${#full_game_array[@]}" full_game_array < <(echo "$chunk_data" | jq -c '.[]' )
  done
  IFS=$oifs
  # echo "first game: ${full_game_array[0]}"
  # fills an associative array with the games and their id
  declare -A -g game_title_arr
  for game in "${full_game_array[@]}"; do
    local game_type=$(echo $game | jq -r ".game_type")
    if [[ "$game_type"  == "game" ]]; then
      local game_id=$( echo "$game" | jq -r ".id" )
      local game_name=$( echo "$game" | jq -r ".title" )
      if [[ -n "${game_title_arr["$game_name"]}" ]]; then
        game_title_arr["$game_name ($game_id)"]=$game_id
      else
        game_title_arr["$game_name"]=$game_id
      fi
    fi
  done
}

convert_to_human() {
    local size=$1
    local precision=10
    readable_size=0
    if (( size >= 1073741824 )); then
        # Multiply by 10 first to save one decimal place of precision
        local scaled=$(( size * $precision / 1073741824 ))
        # Extract the whole number and the decimal remainder
        local int=$(( scaled / $precision ))
        local dec=$(( scaled % $precision ))
        readable_size="${int}.${dec}"
        unit="GiB"
    else
        local scaled=$(( size * $precision / 1048576 ))
        local int=$(( scaled / $precision ))
        local dec=$(( scaled % $precision ))
        readable_size="${int}.${dec}"
        unit="MiB"
    fi
}

get_download_links() {
  local game_id=$1
  local game_info_url="https://api.gog.com/products/$game_id?expand=downloads,expanded_dlcs"
  local tries=0
  # retry ping up to 3 times if it ifails
  while (( tries < 3 )); do
    (( tries++ ))
    local raw_response=$(curl -s -w "%{http_code}" -H "authorization: bearer $auth_code" "$game_info_url")
    # gets the result code for checking
    local http_code="${raw_response: -3}"
    # json response just so no curl a second time
    local json_body="${raw_response:0:${#raw_response}-3}"
    if [[ "$http_code" -eq "200" ]]; then
      break
    elif [[ "$http_code" -eq "401" ]]; then
      use_refresh
      sleep 5
      continue
    fi
  done
  # if it fails 3 times something is underlyingly wrong, exit
  if (( $tries > 3 )); then
    echo "failed getting download links"
    exit 1
  fi
  unset downlinks patches dlcs dlcs_size
  # echo "$json_body"
  local target_os="windows"
  local has_linux=$(echo "$json_body" | jq -r 'if (.downloads.installers | map(select(.os == "linux")) | length > 0) then "yes" else "no" end')
  if [[ "$has_linux" == "yes" ]]; then
    target_os="linux"
  fi

  # get the links from response, and sort them as jq returns lexographical sort
  readarray -t downlinks < <(echo "$json_body" | jq -r --arg os "$target_os" '.downloads.installers[] | select(.os == $os) | .files[].downlink' | sort -V)
  readarray -t patches < <(echo "$json_body" | jq -r --arg os "$target_os" '.downloads.patches[]? | select(.os == $os) | .files[]?.downlink' | sort -V)
  if [[ $patches == "null" ]]; then
    patches=()
  fi
  # maps the dlcs to their names and sizes
  declare -gA dlcs
  declare -gA dlcs_size
  while IFS=$'\t' read -r name downlink size; do
    [[ -z "$name" ]] && continue
    dlcs["$name"]+="$downlink\t"
    convert_to_human $size
    dlcs_size["$name"]="$readable_size $unit"
  done < <(echo "$json_body" | jq -r '.expanded_dlcs[]?.downloads.installers[]? | .name as $n | .files | to_entries[]? | ["\($n) (Part \(.key + 1))", .value.downlink, .value.size] | @tsv')

  # gets the sizes and turns them from bytes into human readable format
  base_size=$(echo "$json_body" | jq -r '.downloads.installers[0].total_size')
  convert_to_human $base_size
  human_base_size="$readable_size $unit"
  patches_size=$(echo "$json_body" | jq -r '[.downloads.patches[]?.total_size] | add')
  # some games don#t have patches so 
  if [[ "$patches_size" != "null" && -n "$patches_size" ]]; then
      convert_to_human $patches_size
      human_patches_size="$readable_size $unit"
  else
      human_patches_size=""
  fi
  # echo "main downloads:"
  # printf '%s\n' "${downlinks[@]}"
  # echo "$human_base_size"
  # echo "patches:"
  # printf '%s\n' "${patches[@]}"
  # echo "$human_patches_size"
  # echo "dlcs:"
  # printf '%s\n' "${!dlcs[@]}"
}

main() {
  parse_args $@
  get_num_cores

  if [[ "$max_cores" -lt $user_inp_cores ]]; then
    echo "user entered core amount is bigger than available, using system max(-1)"
  else
    if [[ "$user_inp_cores" -gt 0 ]]; then
      max_cores=$user_inp_cores
    fi
  fi
  
  echo "max cores available: $max_cores"

  # creates a default config if it doesn't exist yet
  if [[ ! -f $config_file ]]; then
    jq -n --arg dir "$default_dl_loc" '{"dllocfolder": $dir, "refresh_token": null}' > "$config_file"
  fi

  if [[ -z "$dllocfolder" ]]; then
    dllocfolder="$(jq -r '.dllocfolder' "$config_file")"
  else
    jq --arg folder "$dllocfolder" '.dllocfolder = $folder' "$config_file" > /tmp/tmp.json && mv /tmp/tmp.json "$config_file"
  fi
  mkdir -p "$dllocfolder"
  # if no refresh_token in config, then run first time authentication and write it
  if ! jq -e '.refresh_token' "$config_file" >/dev/null; then
    get_authentication
    if [[ ! -z "$refresh_token" ]]; then
      echo "writing refresh_token to file"
      jq --arg refresh_token "$refresh_token" '.refresh_token = $refresh_token' "$config_file" > /tmp/tmp.json && mv /tmp/tmp.json "$config_file"
    else
      echo "no refresh_token was returned" 
    fi
  fi
  # if the auth_code is empty get a new one
  if [[ -z $auth_code ]]; then
    use_refresh
  fi
  # echo "$auth_code"

  echo "getting all games"
  echo -ne "$save_cursor_position"
  while true; do
    echo -ne "$reset_menu_area"
    unset game_title_arr
    get_game_list
    echo "choose the game you want to download:"
    i=0
    # a second array to map the order to the number, since associative isn't consistent order
    local game_internal_id_arr
    readarray -t game_internal_id_arr < <(printf '%s\n' "${!game_title_arr[@]}" | sort -f)
    # print all the games
    for game in "${game_internal_id_arr[@]}"; do
      echo "($i): $game"
      (( i++ ))
    done
    echo "enter the number of the game, r to refresh the game list, and q to quit:"
    local game_choice
    read -r game_choice
    # exit if q or Q is entered
    if [[ "$game_choice" =~ [qQ] ]]; then
      break
    fi
    local game_chosen="${game_internal_id_arr[$game_choice]}"
    # restart the menu if input invalid or refresh chosen
    if [[ ! "$game_choice" =~ ^[0-9]+$ ]] || [[ "$game_choice" =~ [Rr] ]] || [[ -z "$game_chosen" ]] ; then
      unset game_title_arr
      continue
    fi
    local id_chosen="${game_title_arr[$game_chosen]}"
    # echo "$id_chosen: $game_chosen"
    get_download_links "$id_chosen"
    # reset the menu to load the actual download links
    echo -ne "$reset_menu_area"
    # master index for the list
    local menu_index=0
    # giant array with all the links
    local master_links=()
    echo "download choices for $game_chosen: $id_chosen"
    echo "base game downloads:"
    for (( i=0; i < ${#downlinks[@]}; i++ )); do
      echo "$menu_index: installer $i"
      master_links[$menu_index]="${downlinks[$i]}"
      (( menu_index++ ))
    done
    echo "total size of base game installers: $human_base_size"
    if [[ ${#patches[@]} -gt 0 ]]; then
      echo "patches:"
      for (( i=0; i < ${#patches[@]}; i++ )); do
        echo "$menu_index: patch $i"
        master_links[$menu_index]="${patches[$i]}"
        (( menu_index++ ))
      done
      echo "total patch size: $human_patches_size"
    fi
    if [[ ${#dlcs[@]} -gt 0 ]]; then
      echo "dlcs:"
      local dlc_keys
      readarray -d '' -t dlc_keys < <(printf '%s\0' "${!dlcs[@]}" | sort -z -f)
      
      for key in "${dlc_keys[@]}"; do
        # print the menu index, the dlc name (key), and its specific size
        echo "$menu_index: $key [${dlcs_size[$key]}]"
        master_links[$menu_index]="${dlcs[$key]}"
        (( menu_index++ ))
      done
    fi
    echo " use *b - all base installers, *p - all patches, *d - all dlcs, * - every install"
    echo "or you can group it in the format 1,3-5,7-10 to download items 1,3,4,5,7,8,9,10"
    local is_valid=1
    while [[ $is_valid -gt 0 ]]; do
      local all_selected=()
      local mod_selection
      read -rp "enter mod selection: " mod_selection
      local clean_selection="${mod_selection// /}"
      local validation_regex="^(\*|\*b|\*p|\*d|[0-9]+|[0-9]+-[0-9]+)$"
      local selection_arr
      IFS=',' read -ra selection_arr <<< "$clean_selection"
      for item in "${selection_arr[@]}"; do
        if [[ ! "$item" =~ $validation_regex ]]; then
          echo "invalid item: $item, use proper syntax"
          sleep 2
          printf '\e[1A\r\e[2K'
          is_valid=1
          break
        fi
        is_valid=0
        if [[ $item == "*" ]]; then
          readarray -d '' -t all_selected < <(printf '%s\0' "${master_links[@]}")
          break
        fi
        if [[ "$item" == "*"* ]]; then
          case "$item" in
            "*b")
              readarray -d '' -t all_selected -O ${#all_selected[@]} < <(printf '%s\0' "${downlinks[@]}")
              ;;
            "*p")
              readarray -d '' -t all_selected -O ${#all_selected[@]} < <(printf '%s\0' "${patches[@]}")
              ;;
            "*d")
              readarray -d '' -t all_selected -O ${#all_selected[@]} < <(printf '%s\0' "${dlcs[@]}")
              ;;
            "*")
              echo "invalid item: $item, use proper syntax"
              sleep 2
              printf '\e[1A\r\e[2K'
              is_valid=1
              break
              ;;
          esac
          continue
        fi
        IFS='-' read -r start end <<< "$item"
        if [[ -z $end ]]; then
          all_selected[${#all_selected[@]}]="${master_links[$start]}"
        else
          for ((j=$start; j <= $end; j++)); do
            if (( j < ${#master_links[@]} )); then
              all_selected[${#all_selected[@]}]="${master_links[$j]}"
            fi
          done
        fi
      done
    done
    echo -ne "$reset_menu_area"
    echo "downloading game"
    game_download_dir="${dllocfolder}/${game_chosen}"
    mkdir -p "$game_download_dir" 
    declare -A active_pids
    local no_processes=0
    while (( no_processes > 0 || ${#all_selected[@]} > 0 )); do

      while (( no_processes < max_cores )) && (( ${#all_selected[@]} > 0 )); do

        local current_link="${all_selected[0]}"
        all_selected=("${all_selected[@]:1}")
        local cdn_json=$(curl -s -H "authorization: bearer $auth_code" "$current_link")
        local real_downlink=$(echo "$cdn_json" | jq -r '.downlink')
        local filename="${real_downlink##*/}"

        curl -s -L -O --output-dir "$game_download_dir" "$real_downlink" &

        local new_pid=$!
        active_pids[$new_pid]="$filename"

        (( no_processes++ ))
      done

      echo "currently downloading:"

      for pid in "${!active_pids[@]}"; do

        if kill -0 "$pid" 2>/dev/null; then
          echo " -> ${active_pids[$pid]}"
        else
          unset active_pids["$pid"]
        fi
      done

      no_processes=${#active_pids[@]}
      if (( no_processes > 0 )); then

        sleep 2
        local lines_to_clear=$(( no_processes + 1 ))
        printf "\e[%sA\e[J" "$lines_to_clear"

      fi
    done
  done
  exit 0
}

main $@
